{
  "name": "beastMQ",
  "version": "1.0.0",
  "description": "PostgreSQL-backed distributed job queue and agentic task orchestration engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "beastmq": "./dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "tsx tests/run_tests.ts",
    "test:agent": "tsx tests/test_agent_layer.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:push": "npx drizzle-kit push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
